<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gallean.Client"
        x:Class="Gallean.Client.GameView"
        x:DataType="local:GameViewModel"
        Title="{local:Text 'Gallean'}"
        IsWindowed="{Binding IsWindowed}"
        local:SettingsScope.Settings="{Binding Settings}"
        local:CursorLock.IsEnabled="{Binding Settings.LockCursor}"
        WindowStartupLocation="CenterScreen"
        Width="1366"
        Height="768"
        MinWidth="1280"
        MinHeight="720"
        Background="{StaticResource WindowBackgroundBrush}">

  <local:GameSurface x:Name="Surface" />

</Window>
